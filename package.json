{
  "name": "dsh-claw-permissions",
  "version": "0.3.0-rc.1",
  "description": "Layered session permissions for DeepSeek Harness. 有效权限 = 官方 ∩ Agent ∩ 本会话；Claw 会话钉官方沙箱（只紧不松）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "permissions"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./host.js",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./layers": "./perm-layers.mjs",
    "./official": "./perm-official.mjs",
    "./schema": "./perm-schema.mjs",
    "./path": "./perm-path.mjs",
    "./store": "./perm-store.mjs"
  },
  "files": [
    "host.js",
    "client.js",
    "perm-schema.mjs",
    "perm-store.mjs",
    "perm-layers.mjs",
    "perm-path.mjs",
    "perm-official.mjs",
    "perm-i18n.mjs",
    "perm-styles.mjs",
    "perm-page.mjs",
    "perm-runtime.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:check": "node scripts/build-client.mjs --check",
    "test": "npm run build:check && node --test test/*.test.mjs"
  },
  "dependencies": {
    "dsh-claw-core": "0.3.0-rc.1",
    "dsh-claw-policy": "0.3.0-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
